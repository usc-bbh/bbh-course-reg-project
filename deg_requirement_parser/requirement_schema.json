{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "requirement_schema.json",
  "title": "Degree requirements for one program (v2: nodes, anchored by line numbers, of_which checks)",
  "type": "object",
  "required": [
    "program",
    "status",
    "root",
    "unclassified"
  ],
  "additionalProperties": false,
  "properties": {
    "program": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "description": "ok, unless any unclassified entry has reason no_fit (then partial); failed if the input had no usable requirements."
    },
    "root": {
      "description": "The program root: an all_of whose items are anchored nodes. May carry program-wide of_which checks.",
      "type": "object",
      "required": [
        "all_of"
      ],
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/anchored_node"
          }
        },
        "of_which": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/check"
          }
        }
      }
    },
    "unclassified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_lines",
          "source_quote",
          "reason",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "source_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "Line ranges [first, last] (inclusive, 1-based) in the program's .txt file that this encodes. A node with source_lines is an ANCHORED node."
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
          },
          "why": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "no_fit",
              "out_of_scope",
              "university_level",
              "advisory"
            ],
            "description": "no_fit: the taxonomy has no place for it. out_of_scope: deliberately not encoded yet (grades, residency, P/NP, honors, graduate programs). university_level: university- or school-wide rule restated in the program page (GE, writing, 128 units); reused from STARS. advisory: a recommendation, not a requirement."
          }
        }
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "course_code": {
      "type": "string",
      "pattern": "^[A-Z]{2,5} [0-9]{3}[A-Za-z]{0,3}$",
      "description": "Provisional format; normalization TBD."
    },
    "node": {
      "description": "A group (all_of, choose) or a leaf (an object with a family).",
      "oneOf": [
        {
          "$ref": "#/definitions/all_of"
        },
        {
          "$ref": "#/definitions/choose"
        },
        {
          "$ref": "#/definitions/specific_course"
        },
        {
          "$ref": "#/definitions/count"
        },
        {
          "$ref": "#/definitions/course_reuse"
        },
        {
          "$ref": "#/definitions/sequencing"
        },
        {
          "$ref": "#/definitions/manual_review"
        }
      ]
    },
    "anchored_node": {
      "allOf": [
        {
          "$ref": "#/definitions/node"
        },
        {
          "required": [
            "source_lines"
          ]
        }
      ]
    },
    "all_of": {
      "description": "Every item is required. Within the whole program, each course fills at most one slot.",
      "type": "object",
      "required": [
        "all_of"
      ],
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "of_which": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/check"
          },
          "description": "Conditions on the courses THIS node uses. Checks only; never claims courses."
        },
        "source_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Line ranges [first, last] (inclusive, 1-based) in the program's .txt file that this encodes. A node with source_lines is an ANCHORED node."
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      },
      "dependencies": {
        "source_lines": [
          "source_quote",
          "id",
          "description",
          "confidence"
        ],
        "source_quote": [
          "source_lines"
        ],
        "id": [
          "source_lines"
        ],
        "description": [
          "source_lines"
        ],
        "confidence": [
          "source_lines"
        ]
      }
    },
    "choose": {
      "description": "At least `choose` of the items. Each item can be used once.",
      "type": "object",
      "required": [
        "choose",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "choose": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "of_which": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/check"
          },
          "description": "Conditions on the courses THIS node uses. Checks only; never claims courses."
        },
        "source_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Line ranges [first, last] (inclusive, 1-based) in the program's .txt file that this encodes. A node with source_lines is an ANCHORED node."
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      },
      "dependencies": {
        "source_lines": [
          "source_quote",
          "id",
          "description",
          "confidence"
        ],
        "source_quote": [
          "source_lines"
        ],
        "id": [
          "source_lines"
        ],
        "description": [
          "source_lines"
        ],
        "confidence": [
          "source_lines"
        ]
      }
    },
    "specific_course": {
      "description": "Take this one course.",
      "type": "object",
      "required": [
        "family",
        "course"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "specific_course"
        },
        "course": {
          "$ref": "#/definitions/course_code"
        },
        "id": {
          "$ref": "#/definitions/id"
