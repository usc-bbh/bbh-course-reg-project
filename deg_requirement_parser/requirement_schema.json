        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "courses"
          ],
          "additionalProperties": false,
          "properties": {
            "courses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/course_code"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "prefix"
          ],
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2,5}$"
              }
            }
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "level_min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "level_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          }
        },
        {
          "type": "object",
          "required": [
            "school"
          ],
          "additionalProperties": false,
          "properties": {
            "school": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ge_category"
          ],
          "additionalProperties": false,
          "properties": {
            "ge_category": {
              "type": "string",
              "pattern": "^GE-[A-H]$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "unresolved"
          ],
          "additionalProperties": false,
          "properties": {
            "unresolved": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/definitions/condition"
            }
          }
        }
      ]
    }
  }
}