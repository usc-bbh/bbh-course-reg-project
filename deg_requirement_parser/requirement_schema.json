        "description": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Line ranges [first, last] (inclusive, 1-based) in the program's .txt file that this encodes. A node with source_lines is an ANCHORED node."
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      },
      "dependencies": {
        "source_lines": [
          "source_quote",
          "id",
          "description",
          "confidence"
        ],
        "source_quote": [
          "source_lines"
        ],
        "id": [
          "source_lines"
        ],
        "description": [
          "source_lines"
        ],
        "confidence": [
          "source_lines"
        ]
      }
    },
    "count": {
      "description": "Take enough eligible courses to meet every threshold.",
      "type": "object",
      "required": [
        "family",
        "eligible_if",
        "thresholds"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "count"
        },
        "eligible_if": {
          "$ref": "#/definitions/condition"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/threshold"
          }
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "of_which": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/check"
          },
          "description": "Conditions on the courses THIS node uses. Checks only; never claims courses."
        },
        "source_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Line ranges [first, last] (inclusive, 1-based) in the program's .txt file that this encodes. A node with source_lines is an ANCHORED node."
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      },
      "dependencies": {
        "source_lines": [
          "source_quote",
          "id",
          "description",
          "confidence"
        ],
        "source_quote": [
          "source_lines"
        ],
        "id": [
          "source_lines"
        ],
        "description": [
          "source_lines"
        ],
        "confidence": [
          "source_lines"
        ]
      }
    },
    "course_reuse": {
      "description": "PHASE 1 placeholder.",
      "type": "object",
      "required": [
        "family",
        "kind",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "course_reuse"
        },
        "kind": {
          "enum": [
            "DOUBLE_COUNT",
            "UNIQUENESS_FLOOR"
          ]
        },
        "details": {
          "type": "object"
        },
        "id": {
