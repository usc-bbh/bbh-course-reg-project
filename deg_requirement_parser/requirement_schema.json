        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "The first few words of the cited text, copied exactly. Used to catch wrong line numbers."
        }
      },
      "dependencies": {
        "source_lines": [
          "source_quote",
          "id",
          "description",
          "confidence"
        ],
        "source_quote": [
          "source_lines"
        ],
        "id": [
          "source_lines"
        ],
        "description": [
          "source_lines"
        ],
        "confidence": [
          "source_lines"
        ]
      }
    },
    "manual_review": {
      "description": "PHASE 1 placeholder.",
      "type": "object",
      "required": [
        "family",
        "kind",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "manual_review"
        },
        "kind": {
          "enum": [
            "GATE",
            "PROGRAM_RULE",
            "DISCRETIONARY",
            "NO_POOL",
            "PROCEDURAL",
            "HOURS"
          ]
        },
        "details": {
          "type": "object"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": [
