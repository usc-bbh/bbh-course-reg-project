    "threshold": {
      "type": "object",
      "required": [
        "count_by",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "count_by": {
          "enum": [
            "courses",
            "units",
            "departments"
          ]
        },
        "op": {
          "enum": [
            "min",
            "max",
            "eq"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "check": {
      "description": "One of_which condition: of the courses the parent node uses, those passing eligible_if (all of them if omitted) must meet every threshold.",
      "type": "object",
      "required": [
        "source_lines",
        "source_quote",
        "thresholds"
      ],
      "additionalProperties": false,
      "properties": {
        "eligible_if": {
          "$ref": "#/definitions/condition"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/threshold"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
